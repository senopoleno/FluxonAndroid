<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen_ambient">

    <!-- ─────── Top bar: Settings + Config + Split Tunnel ─────── -->
    <ImageView
        android:id="@+id/btnSettings"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="20dp"
        android:padding="9dp"
        android:src="@drawable/ic_settings"
        android:background="@drawable/bg_config_selector"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="@string/settings_title"
        app:tint="@color/text_primary"
        app:layout_constraintTop_toTopOf="@id/configSelector"
        app:layout_constraintBottom_toBottomOf="@id/configSelector"
        app:layout_constraintStart_toStartOf="parent" />

    <LinearLayout
        android:id="@+id/configSelector"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_marginTop="16dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="14dp"
        android:background="@drawable/bg_config_selector"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@id/btnSettings"
        app:layout_constraintEnd_toStartOf="@id/btnSplitTunnel">

        <View
            android:id="@+id/configDot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/bg_dropdown_dot"
            android:layout_marginEnd="10dp" />

        <TextView
            android:id="@+id/tunnelName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:maxWidth="170dp"
            tools:text="My Tunnel" />

        <ImageView
            android:id="@+id/chevron"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="8dp"
            android:src="@drawable/ic_chevron_down"
            app:tint="@color/text_secondary" />

    </LinearLayout>

    <ImageView
        android:id="@+id/btnSplitTunnel"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="20dp"
        android:padding="9dp"
        android:src="@drawable/ic_split_tunnel"
        android:background="@drawable/bg_config_selector"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="@string/split_tunneling_title"
        app:tint="@color/text_primary"
        app:layout_constraintTop_toTopOf="@id/configSelector"
        app:layout_constraintBottom_toBottomOf="@id/configSelector"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/statusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textColor="@color/text_primary"
        android:textSize="24sp"
        android:fontFamily="sans-serif-light"
        app:layout_constraintTop_toBottomOf="@id/configSelector"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="Tap to connect" />

    <!-- ─────── Header: uptime (top) + speed (below) (under statusText) ─────── -->
    <LinearLayout
        android:id="@+id/uptimeContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:alpha="0"
        app:layout_constraintTop_toBottomOf="@id/statusText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Uptime Pill -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="14dp"
            android:paddingVertical="5dp"
            android:background="@drawable/bg_config_selector">

            <TextView
                android:id="@+id/uptimeLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/uptime_label"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/uptimeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:fontFamily="monospace"
                android:textStyle="bold"
                tools:text="00:42" />

        </LinearLayout>

        <!-- Speed (Below Uptime, Clean Text without Background Pill) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/speedIcon"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginEnd="6dp"
                android:src="@drawable/ic_speed"
                android:contentDescription="@null"
                app:tint="@color/text_secondary" />

            <TextView
                android:id="@+id/speedText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:fontFamily="monospace"
                tools:text="↓ 0 B/s   ↑ 0 B/s" />

        </LinearLayout>

        <!-- Memory Monitor (RAM Usage) -->
        <LinearLayout
            android:id="@+id/memoryContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:background="@drawable/bg_badge_memory"
            android:visibility="gone">

            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginEnd="5dp"
                android:src="@drawable/ic_memory"
                app:tint="@color/text_tertiary"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/memoryText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:fontFamily="sans-serif"
                tools:text="ОЗУ: 42 МБ" />

        </LinearLayout>

    </LinearLayout>

    <!-- ─────── Center: aurora + rings + button ─────── -->
    <FrameLayout
        android:id="@+id/center"
        android:layout_width="340dp"
        android:layout_height="340dp"
        app:layout_constraintTop_toBottomOf="@id/uptimeContainer"
        app:layout_constraintBottom_toTopOf="@id/bottomBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <io.github.p1neapplexpress.openflux.ui.widget.AuroraView
            android:id="@+id/aurora"
            android:layout_width="340dp"
            android:layout_height="340dp"
            android:layout_gravity="center" />

        <io.github.p1neapplexpress.openflux.ui.widget.PulseRingsView
            android:id="@+id/pulseRings"
            android:layout_width="308dp"
            android:layout_height="308dp"
            android:layout_gravity="center" />

        <View
            android:id="@+id/ringOuter"
            android:layout_width="248dp"
            android:layout_height="248dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_ring_outer" />

        <View
            android:id="@+id/ringMid"
            android:layout_width="204dp"
            android:layout_height="204dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_ring_mid" />

        <FrameLayout
            android:id="@+id/connectButton"
            android:layout_width="164dp"
            android:layout_height="164dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_button_ripple"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/powerIcon"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_power"
                android:alpha="0.92"
                app:tint="@color/text_primary" />

        </FrameLayout>

    </FrameLayout>

    <!-- ─────── Bottom bar: Add (top) + Enter manually (bottom) ─────── -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="24dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Кнопка «Добавить» (по QR-коду) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/addButton"
            style="@style/Widget.Material3.Button"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="@string/add_tunnel_short"
            android:textAllCaps="false"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/colorOnPrimary"
            app:backgroundTint="@color/accent_blue"
            app:cornerRadius="14dp"
            app:icon="@drawable/ic_add_qr"
            app:iconTint="@color/colorOnPrimary"
            app:iconGravity="textStart"
            app:iconPadding="10dp"
            android:insetTop="0dp"
            android:insetBottom="0dp" />

        <!-- Кнопка «Ввести вручную» (ниже кнопки добавить) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/switchButton"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:text="@string/switch_tunnel"
            android:textAllCaps="false"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/text_primary"
            app:strokeColor="@color/bg_card_stroke"
            app:strokeWidth="1dp"
            app:cornerRadius="14dp"
            app:icon="@drawable/ic_edit"
            app:iconTint="@color/text_secondary"
            app:iconGravity="textStart"
            app:iconPadding="10dp"
            android:insetTop="0dp"
            android:insetBottom="0dp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

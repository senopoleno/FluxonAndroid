<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_screen_ambient">

    <!-- Top Action Bar -->
    <LinearLayout
        android:id="@+id/logs_top_bar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp">

        <TextView
            android:id="@+id/tv_logs_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/logs_title"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:fontFamily="sans-serif-medium"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/tv_line_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_config_selector"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:fontFamily="monospace"
            tools:text="0 строк" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Auto-scroll toggle button -->
        <ImageView
            android:id="@+id/btn_autoscroll"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:padding="8dp"
            android:layout_marginEnd="6dp"
            android:src="@drawable/ic_refresh"
            android:background="@drawable/bg_config_selector"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/auto_scroll"
            app:tint="@color/state_running" />

        <!-- Copy button -->
        <ImageView
            android:id="@+id/btn_copy"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:padding="8dp"
            android:layout_marginEnd="6dp"
            android:src="@drawable/ic_content_copy"
            android:background="@drawable/bg_config_selector"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/copy"
            app:tint="@color/text_primary" />

        <!-- Clear button -->
        <ImageView
            android:id="@+id/btn_clear"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:padding="8dp"
            android:src="@drawable/ic_delete"
            android:background="@drawable/bg_config_selector"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/clear"
            app:tint="@color/state_error" />

    </LinearLayout>

    <!-- Terminal Console Window Card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginHorizontal="12dp"
        android:layout_marginBottom="14dp"
        app:cardBackgroundColor="@color/bg_card"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/bg_card_stroke"
        app:strokeWidth="1dp">

        <ScrollView
            android:id="@+id/log_scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="vertical"
            android:fadeScrollbars="false">

            <TextView
                android:id="@+id/logs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:lineSpacingExtra="2.5dp"
                android:padding="14dp"
                android:textColor="@color/text_primary"
                android:textSize="11.5sp"
                android:textIsSelectable="true" />

        </ScrollView>

    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
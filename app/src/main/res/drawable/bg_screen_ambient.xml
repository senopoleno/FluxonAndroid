<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_deep" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:centerX="0.5"
                android:centerY="0.30"
                android:gradientRadius="900dp"
                android:startColor="#144F7CFF"
                android:centerColor="#084F7CFF"
                android:endColor="@android:color/transparent"
                android:tileMode="clamp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:centerX="0.5"
                android:centerY="0.95"
                android:gradientRadius="700dp"
                android:startColor="#0A7C4FFF"
                android:centerColor="#047C4FFF"
                android:endColor="@android:color/transparent"
                android:tileMode="clamp" />
        </shape>
    </item>
</layer-list>
